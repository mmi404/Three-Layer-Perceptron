# =============================================================================
#  CinemaSeat — configuration
#
#  You do NOT need this file to run the project. `docker compose up` works on a
#  clean clone using the defaults baked into docker-compose.yml. Copy this to
#  .env only when you want to override something.
#
#  .env is gitignored. Never commit real secrets.
# =============================================================================

PROJECT_NAME=cinemaseat

# --- Host ports -------------------------------------------------------------
HTTP_PORT=8080
POSTGRES_PORT=55432          # bound to 127.0.0.1 only

# --- Database ---------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app        # change for any public deployment
POSTGRES_DB=cinemaseat

# --- App --------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=*               # comma-separated allowlist, or * for any

# --- Booking behaviour ------------------------------------------------------
# JUDGING HOOK: hold lifetime in seconds, read from the environment.
# Judges run the stack with a short value to watch a hold expire:
#     HOLD_TTL_SECONDS=10 docker compose up
HOLD_TTL_SECONDS=120

# A payment stuck PENDING longer than this is failed and its seats released.
PAYMENT_TIMEOUT_SECONDS=90

# Seat-map cache lifetime. Busted on every seat-state change.
SEATMAP_CACHE_MS=1000

# --- Provided gateway -------------------------------------------------------
# live          = the documented misbehaviour (delays, failures, duplicates)
# deterministic = 2s delay, always succeeds. FOR BUILDING ONLY.
#                 Turn it off before you believe any measurement.
GATEWAY_MODE=live

# Allows callers to send X-Debug-Force, which we pass through to the gateway
# as X-Mock-Force. Judges use the force headers to test identical conditions.
DEBUG_FORCE_ENABLED=true
GATEWAY_TIMEOUT_MS=5000

# --- Rate limiting ----------------------------------------------------------
# High on purpose: Scenario A fires 100 concurrent holds for a single seat from
# one IP. Throttling them would invalidate the test. Seat contention is
# resolved in Postgres, not by a rate limiter.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=5

# --- Frontend (baked in at build time) --------------------------------------
VITE_API_URL=/api
