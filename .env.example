# =============================================================================
#  Copy to .env and fill in.  .env is gitignored — NEVER commit it.
#  "No hardcoded secrets" is an explicit line on the scoring rubric.
# =============================================================================

PROJECT_NAME=z2p

# --- Host ports -------------------------------------------------------------
# On a VPS that already serves sites on :80/:443, keep HTTP_PORT off 80 and
# reverse-proxy to it from the existing nginx. Locally, 8080 is fine.
HTTP_PORT=8080
POSTGRES_PORT=55432

# --- Database ---------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_before_deploy
POSTGRES_DB=appdb

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_32_bytes_minimum_change_me
JWT_EXPIRES_IN=15m

# Comma-separated. NEVER use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# --- Frontend (baked in at build time) --------------------------------------
VITE_API_URL=/api

# --- Optional ---------------------------------------------------------------
# ACME_EMAIL=you@example.com      # for Let's Encrypt via Traefik
# SENTRY_DSN=
